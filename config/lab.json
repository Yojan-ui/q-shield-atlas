{
  "label": "Local lab TLS services (openssl s_server on 127.0.0.1). Configuration and policy, not measurements.",
  "openssl": {
   "path": "/opt/anaconda3/envs/pqc/bin/openssl",
   "version": "OpenSSL 3.6.5 29 Sep 2026 (Library: OpenSSL 3.6.5 29 Sep 2026)",
   "conda_package": "openssl 3.6.5 h55eecbc_0 (conda-forge), env pqc",
   "requires": {
    "tls_group": "X25519MLKEM768",
    "signature": "ML-DSA-65",
    "min_version": "3.5"
   },
   "override_env": "QSHIELD_OPENSSL",
   "note": "Machine-specific path. Lookup order: $QSHIELD_OPENSSL, this path, openssl next to the Python interpreter, PATH; the chosen binary must list X25519MLKEM768 and ML-DSA-65."
  },
  "modes": {
    "legacy":     {"groups": "X25519",                "tls": "1.2+", "note": "classical key exchange only"},
    "transition": {"groups": "X25519MLKEM768:X25519", "tls": "1.2+", "note": "hybrid preferred, classical still allowed"},
    "strict":     {"groups": "X25519MLKEM768",        "tls": "1.3",  "note": "hybrid only; TLS 1.3 only because with TLS 1.2 allowed a 1.2 client falls back to classical FFDHE"}
  },
  "services": {
    "legacy": {"mode": "legacy", "cert_key": "rsa:2048"},
    "hybrid": {"mode": "strict", "cert_key": "rsa:2048"},
    "pq-auth": {"mode": "strict", "cert_key": "ML-DSA-65"}
  },
  "clients": {
    "pq-capable":     {"groups": "X25519MLKEM768:X25519", "tls": "auto"},
    "classical-only": {"groups": "X25519",                "tls": "auto"},
    "tls1.2-only":    {"groups": "X25519",                "tls": "1.2"}
  },
  "compat_policy": {
    "note": "Expected outcome per (mode, client). Code enforces two extra rules: a PQ-capable client in a mode that offers a PQ group must get it, and any classical session is flagged HNDL-exposed, never PASS.",
    "legacy": {
      "pq-capable":     {"expect": "connect", "group": "X25519"},
      "classical-only": {"expect": "connect", "group": "X25519"},
      "tls1.2-only":    {"expect": "connect", "group": "X25519"}
    },
    "transition": {
      "pq-capable":     {"expect": "connect", "group": "X25519MLKEM768"},
      "classical-only": {"expect": "connect", "group": "X25519"},
      "tls1.2-only":    {"expect": "connect", "group": "X25519"}
    },
    "strict": {
      "pq-capable":     {"expect": "connect", "group": "X25519MLKEM768"},
      "classical-only": {"expect": "refused"},
      "tls1.2-only":    {"expect": "refused"}
    }
  },
  "client_groups": "X25519MLKEM768:X25519",
  "classical_only_client_groups": "X25519:prime256v1",
  "pq_group_allowlist": ["X25519MLKEM768", "SecP256r1MLKEM768", "SecP384r1MLKEM1024", "MLKEM512", "MLKEM768", "MLKEM1024"],
  "pq_auth_allowlist": ["ML-DSA", "SLH-DSA"],
  "health_check_client": "classical-only",
  "waves": {
    "initial_mode": "legacy",
    "target_mode": "transition",
    "max_processes": 4,
    "lab_services_by_kind": {
      "tls_gateway": "edge",
      "cdn_edge": "edge",
      "service_mtls": "app",
      "message_bus": "app",
      "database_tls": "data"
    },
    "note": "Kinds with no TLS lab stand-in (root_ca, hsm, vpn, batch_sftp) are reported not_verified_in_lab."
  },
  "timeouts_s": {"keygen": 30, "startup": 10, "handshake": 15, "shutdown": 5},
  "hndl_label": "HNDL-exposed: recorded traffic relies on classical key exchange"
}
