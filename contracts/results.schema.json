{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://q-shield-atlas.local/contracts/results.schema.json",
  "title": "Q-Shield Atlas results",
  "description": "Single document the viz reads. Every number must come from a logged run listed in solver_runs (or later module sections). Sections owned by modules not yet built are null.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "generated_at", "assumptions", "scenarios", "assets", "waves",
    "exposure", "baselines", "avoided", "solver_runs",
    "detect", "handshake_evidence", "gates", "qaoa", "ledger_root", "ledger", "ledger_verification"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "assumptions": {
      "type": "object",
      "description": "Copy of the assumption config used (shelf lives, risk weights, effort, capacity, scenarios). These are assumptions, not measurements.",
      "required": ["label", "sha256"],
      "properties": {
        "label": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "year", "weight"],
        "properties": {
          "name": {"type": "string"},
          "year": {"type": "number"},
          "weight": {"type": "number", "minimum": 0}
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "algorithm", "shelf_life_years", "effort_days", "risk_weight", "depends_on", "status", "planned_week"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "kind": {"type": "string"},
          "data_class": {"type": "string"},
          "algorithm": {"type": "string"},
          "shelf_life_years": {"type": "number", "minimum": 0},
          "effort_days": {"type": "number", "exclusiveMinimum": 0},
          "risk_weight": {"type": "number", "minimum": 0},
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "status": {"$ref": "#/$defs/status"},
          "planned_week": {"type": "integer", "minimum": 1},
          "evidence": {"type": "array"}
        }
      }
    },
    "waves": {"$ref": "#/$defs/waves"},
    "exposure": {"$ref": "#/$defs/plan_summary"},
    "baselines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fcfs", "greedy"],
      "properties": {
        "fcfs": {"$ref": "#/$defs/plan_summary"},
        "greedy": {"$ref": "#/$defs/plan_summary"}
      }
    },
    "avoided": {
      "type": "object",
      "description": "Baseline minus optimized, per scenario, on the same data.",
      "additionalProperties": false,
      "required": ["vs_fcfs", "vs_greedy"],
      "properties": {
        "vs_fcfs": {"$ref": "#/$defs/avoided_list"},
        "vs_greedy": {"$ref": "#/$defs/avoided_list"}
      }
    },
    "solver_runs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/solver_run"}},
    "sensitivity": {"type": ["array", "null"]},
    "detect": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/detect"}]},
    "handshake_evidence": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/handshake_evidence"}]},
    "gates": {"type": ["object", "null"]},
    "qaoa": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/qaoa"}]},
    "ledger_root": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "ledger_verification": {
      "description": "Result of the last `python -m ledger verify`; cleared by ingest. Valid for the anchored root only if root and entries_checked match `ledger`.",
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ok", "ts", "entries_checked", "root", "verifying_pubkey_fp", "first_failure"],
          "properties": {
            "ok": {"type": "boolean"},
            "ts": {"type": "string", "format": "date-time"},
            "entries_checked": {"type": "integer", "minimum": 0},
            "root": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
            "verifying_pubkey_fp": {"$ref": "#/$defs/sha256"},
            "first_failure": {"type": ["object", "null"]}
          }
        }
      ]
    },
    "ledger": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["root", "entry_count", "pubkey_fp", "alg", "backend", "ledger_ref"],
          "properties": {
            "root": {"$ref": "#/$defs/sha256"},
            "entry_count": {"type": "integer", "minimum": 0},
            "pubkey_fp": {"$ref": "#/$defs/sha256"},
            "alg": {"const": "ML-DSA-65"},
            "backend": {"type": "string"},
            "ledger_ref": {"type": "string"},
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["index", "type", "payload_ref"],
                "properties": {"index": {"type": "integer", "minimum": 0}, "type": {"type": "string"}, "payload_ref": {"type": "string"}}
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "qaoa_metrics": {
      "type": "object",
      "required": ["shots", "feasible_fraction", "best_feasible_objective", "approximation_ratio", "mean_energy", "energy_ratio", "p_optimal", "p_optimal_assets"],
      "properties": {
        "shots": {"type": "integer", "minimum": 1},
        "feasible_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "best_feasible_objective": {"type": ["number", "null"]},
        "approximation_ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 1.000001},
        "mean_energy": {"type": "number"},
        "energy_ratio": {"type": ["number", "null"]},
        "p_optimal": {"type": "number", "minimum": 0, "maximum": 1},
        "p_optimal_assets": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "qaoa": {
      "type": "object",
      "required": ["label", "run_id", "ts", "problem", "exact", "runs", "comparisons", "qcloud", "table", "ledger_index"],
      "properties": {
        "ledger_index": {"type": ["integer", "null"], "minimum": 0},
        "table": {
          "description": "One row per (p, source) for display. Non-ok rows have metrics null and a status_text; never blanks or zeros.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["p", "source", "status", "status_text", "backend", "shots", "job_ids", "metrics"],
            "properties": {
              "p": {"type": ["integer", "null"]},
              "source": {"enum": ["local", "qpiai_local", "qcloud", "random"]},
              "status": {"enum": ["ok", "failed", "skipped", "not_requested"]},
              "status_text": {"type": ["string", "null"]},
              "backend": {"type": "string"},
              "shots": {"type": ["integer", "null"]},
              "job_ids": {"type": "array", "items": {"type": "string"}},
              "metrics": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/qaoa_metrics"}]},
              "job_id": {"type": "null"},
              "job_id_reason": {"type": "string", "minLength": 1},
              "comparison": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["z_scores", "sigma_threshold", "differs"]}]}
            },
            "allOf": [
              {"if": {"properties": {"source": {"const": "qpiai_local"}}, "required": ["source"]},
               "then": {"required": ["job_id", "job_id_reason"], "properties": {"job_ids": {"maxItems": 0}}}},
              {"if": {"properties": {"status": {"const": "ok"}}},
               "then": {"properties": {"metrics": {"type": "object"}, "status_text": {"type": "null"}}},
               "else": {"properties": {"metrics": {"type": "null"}, "status_text": {"type": "string", "minLength": 1}}}},
              {"if": {"properties": {"source": {"const": "qcloud"}, "status": {"const": "ok"}}, "required": ["source", "status"]},
               "then": {"properties": {"job_ids": {"minItems": 1}}}}
            ]
          }
        },
        "label": {"type": "string", "pattern": "No quantum advantage claimed"},
        "run_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "problem": {
          "type": "object",
          "required": ["week", "assets", "n_variables", "slack_bits", "A", "B", "bit_order", "shrink_log"],
          "properties": {"n_variables": {"type": "integer", "maximum": 16}}
        },
        "exact": {
          "type": "object",
          "required": ["objective", "assets", "bitstring", "method", "run_id"],
          "properties": {"bitstring": {"type": "string", "pattern": "^[01]+$"}}
        },
        "runs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["p", "source", "backend", "shots", "angles", "job_ids", "metrics"],
            "properties": {
              "p": {"type": ["integer", "null"], "minimum": 1},
              "source": {"enum": ["local", "qpiai_local", "qcloud", "random"]},
              "backend": {"type": "string"},
              "shots": {"type": "integer", "minimum": 1},
              "angles": {
                "oneOf": [
                  {"type": "null"},
                  {"type": "object", "required": ["gammas", "betas"],
                   "properties": {"gammas": {"type": "array", "items": {"type": "number"}}, "betas": {"type": "array", "items": {"type": "number"}}}}
                ]
              },
              "job_ids": {"type": "array", "items": {"type": "string"}},
              "metrics": {"$ref": "#/$defs/qaoa_metrics"}
            },
            "allOf": [
              {"if": {"properties": {"source": {"const": "qcloud"}}}, "then": {"properties": {"job_ids": {"minItems": 1}}}},
              {"if": {"properties": {"source": {"const": "qpiai_local"}}, "required": ["source"]},
               "then": {"required": ["job_id", "job_id_reason", "sdk_version", "inputs_sha256", "outputs_sha256"],
                        "properties": {"job_id": {"type": "null"}, "job_ids": {"maxItems": 0}}}}
            ]
          }
        },
        "comparisons": {"type": "array"},
        "qcloud": {"type": "object", "required": ["requested"]}
      }
    },
    "handshake_evidence": {
      "type": "object",
      "description": "Real TLS 1.3 handshake metadata from capture/. No decryption is performed or claimed.",
      "additionalProperties": false,
      "required": ["run_id", "ts", "capture_sha256", "openssl_version", "sessions", "note"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "ts": {"type": "string", "format": "date-time"},
        "capture_sha256": {"$ref": "#/$defs/sha256"},
        "openssl_version": {"type": "string"},
        "note": {"type": "string"},
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["service_id", "negotiated_group", "kex_class", "hndl_exposed", "label", "transcript_sha256"],
            "properties": {
              "service_id": {"type": "string"},
              "negotiated_group": {"type": "string"},
              "kex_class": {"enum": ["classical", "hybrid-pq"]},
              "hndl_exposed": {"type": "boolean"},
              "label": {"type": ["string", "null"]},
              "transcript_sha256": {"$ref": "#/$defs/sha256"},
              "auth_alg": {"type": "string"},
              "auth_class": {"enum": ["pq", "classical"]}
            }
          }
        }
      }
    },
    "detect": {
      "type": "object",
      "required": ["run_id", "ts", "scanned_root", "tree_sha256", "files_scanned", "summary", "findings", "probes", "drift_count", "inventory"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "files_scanned": {"type": "integer", "minimum": 0},
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "line", "rule", "family", "use", "confidence", "snippet"],
            "properties": {
              "file": {"type": "string"},
              "line": {"type": "integer", "minimum": 1},
              "family": {"enum": ["RSA", "ECC", "DH", "DSA", "PQC", "UNKNOWN"]},
              "use": {"enum": ["kex", "sig", "both"]},
              "confidence": {"enum": ["high", "medium", "low"]}
            }
          }
        },
        "probes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["service", "endpoint", "live", "drift"],
            "properties": {
              "drift": {
                "type": "array",
                "items": {"type": "object", "required": ["kind", "severity", "detail"]}
              }
            }
          }
        },
        "drift_count": {"type": "integer", "minimum": 0}
      }
    },
    "status": {
      "description": "planned until the wave runner has run; applied only when every gate passed on a lab stand-in.",
      "enum": ["planned", "applied", "partially_verified", "rolled_back", "rollback_failed", "not_verified_in_lab"]
    },
    "waves": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["week", "assets", "effort_days", "status"],
        "properties": {
          "week": {"type": "integer", "minimum": 1},
          "assets": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "effort_days": {"type": "number", "minimum": 0},
          "status": {"$ref": "#/$defs/status"},
          "asset_status": {"type": "object", "additionalProperties": {"$ref": "#/$defs/status"}},
          "evidence": {
            "type": "object",
            "required": ["run_id", "ts", "lab_services"],
            "properties": {
              "run_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
              "ts": {"type": "string", "format": "date-time"},
              "lab_services": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["lab_service", "assets", "status", "snapshot_sha256", "applied_config_sha256", "gates"],
                  "properties": {
                    "status": {"enum": ["applied", "rolled_back", "rollback_failed"]},
                    "snapshot_sha256": {"$ref": "#/$defs/sha256"},
                    "applied_config_sha256": {"$ref": "#/$defs/sha256"},
                    "restored_config_sha256": {"$ref": "#/$defs/sha256"}
                  }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"enum": ["applied", "partially_verified", "rolled_back", "rollback_failed"]}}},
            "then": {"required": ["asset_status", "evidence"]}
          }
        ]
      }
    },
    "scenario_exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario", "year", "exposure_years", "weighted_exposure"],
      "properties": {
        "scenario": {"type": "string"},
        "year": {"type": "number"},
        "exposure_years": {"type": "number", "minimum": 0},
        "weighted_exposure": {"type": "number", "minimum": 0}
      }
    },
    "plan_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "completion_week", "per_scenario", "expected_weighted", "worst_case_weighted", "makespan_weeks", "produced_by"],
      "properties": {
        "method": {"type": "string"},
        "objective": {"enum": ["expected", "robust"]},
        "completion_week": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
        "waves": {"$ref": "#/$defs/waves"},
        "per_scenario": {"type": "array", "items": {"$ref": "#/$defs/scenario_exposure"}},
        "expected_weighted": {"type": "number", "minimum": 0},
        "worst_case_weighted": {"type": "number", "minimum": 0},
        "makespan_weeks": {"type": "integer", "minimum": 0},
        "remaining_by_week": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scenario", "year", "points"],
            "properties": {
              "scenario": {"type": "string"},
              "year": {"type": "number"},
              "points": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["week", "exposure_years"],
                  "properties": {"week": {"type": "integer", "minimum": 0}, "exposure_years": {"type": "number", "minimum": 0}}
                }
              }
            }
          }
        },
        "produced_by": {
          "type": "object",
          "additionalProperties": false,
          "required": ["solver", "run_ids", "job_ids"],
          "properties": {
            "solver": {"type": "string", "minLength": 1},
            "run_ids": {"type": "array", "items": {"type": "string"}},
            "job_ids": {"type": "array", "items": {"type": ["string", "null"]}}
          }
        }
      }
    },
    "avoided_list": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario", "exposure_years_avoided", "weighted_avoided"],
        "properties": {
          "scenario": {"type": "string"},
          "exposure_years_avoided": {"type": "number"},
          "weighted_avoided": {"type": "number"}
        }
      }
    },
    "solver_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "ts", "stage", "solver", "provider", "package_version", "mode", "job_id", "job_id_reason", "status", "inputs_sha256", "output_sha256"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "ts": {"type": "string", "format": "date-time"},
        "stage": {"type": "string"},
        "provider": {"type": "string"},
        "package_version": {"type": "string"},
        "mode": {"enum": ["local", "platform"]},
        "device": {"type": ["string", "null"]},
        "job_id": {"type": ["string", "null"]},
        "job_id_reason": {"type": ["string", "null"]},
        "solver": {"type": "string", "minLength": 1, "description": "Which solver produced this run's numbers, e.g. 'qpiai-opt platform' or 'qpiai-opt local'."},
        "problem_id": {"type": ["string", "null"]},
        "fallback_reason": {"type": ["string", "null"]},
        "local_output_sha256": {"$ref": "#/$defs/sha256"},
        "comparison": {
          "type": ["object", "null"],
          "description": "Platform vs local objective on the identical input; both kept, never silently merged.",
          "additionalProperties": false,
          "required": ["platform_objective", "local_objective", "abs_diff", "match"],
          "properties": {
            "platform_objective": {"type": "number"},
            "local_objective": {"type": "number"},
            "abs_diff": {"type": "number", "minimum": 0},
            "match": {"type": "boolean"}
          }
        },
        "status": {"type": "string"},
        "termination": {"type": ["string", "null"]},
        "guarantee": {"type": ["string", "null"]},
        "objective": {"type": ["number", "null"]},
        "solver_time_s": {"type": ["number", "null"]},
        "inputs_sha256": {"$ref": "#/$defs/sha256"},
        "output_sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {"properties": {"job_id": {"type": "null"}}},
          "then": {"properties": {"job_id_reason": {"type": "string", "minLength": 10}}}
        }
      ]
    }
  }
}
